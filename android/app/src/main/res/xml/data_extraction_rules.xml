<?xml version="1.0" encoding="utf-8"?>
<!-- 検索履歴DBをクラウドバックアップ・端末間移行から除外する（F-04, プライバシー要件） -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
